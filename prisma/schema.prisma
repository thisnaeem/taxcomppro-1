generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  PROFESSIONAL
  ADMIN
}

enum AppStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionTier {
  FREE
  VIP
  MARKETPLACE
  MARKETPLACE_PLUS
}

enum ListingCategory {
  SERVICE
  PRODUCT
  NETWORK
  TRAINING
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LessonContentType {
  VIDEO
  TEXT
  QUIZ
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum BlastStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  APPROVED
  DELIVERED
  REJECTED
}

enum AdStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  REJECTED
  EXPIRED
}

enum AdPlacement {
  CENTER_COLUMN
  LEFT_COLUMN
}

enum FeaturedListingStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  EXPIRED
}

enum CardVisibility {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

enum TrainingStatus {
  INVITED
  REGISTERED
  TRAINING_STARTED
  VIDEO_COMPLETED
  ASSESSMENT_REQUIRED
  PASSED
  FAILED_RETAKE_REQUIRED
  TRAINING_COMPLETED
  ACCESS_REVOKED
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  emailVerified    Boolean          @default(false)
  name             String
  role             Role             @default(MEMBER)
  tier             SubscriptionTier @default(FREE)
  image            String?
  coverImage       String?
  bio              String?
  headline         String?
  location         String?
  yearsExperience  Int?
  mission          String?
  website          String?
  linkedIn         String?
  twitter          String?
  facebook         String?
  specialties      String[]
  certifications   String[]
  languages        String[]
  mediaPhotos      String[]
  stripeCustomerId   String?
  stripeAccountId    String?  // Stripe Connect Express account ID
  stripeOnboarded    Boolean  @default(false)
  voiceMemoUrl       String?  // Cloudinary URL of voice memo (max 4 min)
  createdAt          DateTime @default(now())
  updatedAt        DateTime         @updatedAt

  sessions            Session[]
  accounts            Account[]
  listings            MarketplaceListing[]
  createdCommunities  Community[]
  communityMembers    CommunityMember[]
  posts               Post[]
  comments            Comment[]
  postLikes           PostLike[]
  subscription        Subscription?
  notifications       Notification[]
  sentConnections     Connection[]         @relation("Requester")
  receivedConnections Connection[]         @relation("Receiver")
  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  instructorCourses   Course[]             @relation("InstructorCourses")
  enrollments         Enrollment[]
  quizAttempts        QuizAttempt[]
  courseRatings       CourseRating[]
  affiliateProfile    AffiliateProfile?
  referredBy          AffiliateReferral[]  @relation("ReferredUser")
  hostedSpaces        Space[]
  spaceRsvps          SpaceRsvp[]
  proApplication      ProfessionalApplication?
  proServices         ProService[]
  reviewsReceived     ProReview[]  @relation("ReviewedPro")
  reviewsGiven        ProReview[]  @relation("Reviewer")
  toolkitPurchases    ToolkitPurchase[]
  messageBlasts       MessageBlast[]
  proAds              ProAd[]
  featuredListings    FeaturedListingRequest[]
  forums              Forum[]
  forumPosts          ForumPost[]
  forumComments       ForumComment[]
  forumVotes          ForumVote[]
  marketplacePurchases MarketplacePurchase[]
  digitalCard         DigitalCard?
  trainingLicenses     TrainingLicense[]
  eroInvitationsSent   StaffInvitation[] @relation("EroInvitations")
  preparerInvitations  StaffInvitation[] @relation("PreparerInvitations")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model MarketplaceListing {
  id          String          @id @default(cuid())
  slug        String?         @unique
  title       String
  description String
  category    ListingCategory
  price       Float?
  images      String[]
  tags        String[]
  status      ListingStatus   @default(PENDING)
  isFeatured  Boolean         @default(false)
  userId      String
  viewCount   Int             @default(0)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  featuredRequests FeaturedListingRequest[]
  purchases        MarketplacePurchase[]

  @@map("marketplace_listings")
}

model MarketplacePurchase {
  id              String             @id @default(cuid())
  userId          String
  listingId       String
  price           Float              @default(0)
  stripeSessionId String?            @unique
  createdAt       DateTime           @default(now())

  user    User               @relation(fields: [userId],    references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("marketplace_purchases")
}

model FeaturedListingRequest {
  id               String                 @id @default(cuid())
  userId           String
  listingId        String
  durationMonths   Int
  priceUsd         Float
  status           FeaturedListingStatus  @default(PENDING_PAYMENT)
  stripeSessionId  String?
  rejectionReason  String?
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("featured_listing_requests")
}


model Community {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  coverImage  String?
  icon        String?
  isPublic    Boolean  @default(true)
  creatorId   String
  memberCount Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members CommunityMember[]
  posts   Post[]

  @@map("communities")
}

model CommunityMember {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@map("community_members")
}

model Post {
  id          String    @id @default(cuid())
  content     String
  authorId    String
  communityId String?
  images      String[]
  videoUrl    String?
  likeCount   Int       @default(0)
  commentCount Int      @default(0)
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     PostLike[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_likes")
}

model Subscription {
  id                   String           @id @default(cuid())
  userId               String           @unique
  plan                 SubscriptionTier
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String           @default("active")
  currentPeriodEnd     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@map("connections")
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  content     String   @default("")
  fileUrl     String?
  fileName    String?
  fileType    String?
  isRead      Boolean  @default(false)
  isSponsored Boolean  @default(false)
  blastId     String?
  createdAt   DateTime @default(now())

  sender   User          @relation("SentMessages",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  blast    MessageBlast? @relation(fields: [blastId], references: [id], onDelete: SetNull)

  @@map("messages")
}

model MessageBlast {
  id              String      @id @default(cuid())
  senderId        String
  subject         String
  content         String
  filterRoles     String[]
  filterCities    String[]
  filterStates    String[]
  recipientCount  Int
  priceUsd        Float
  stripeSessionId String?
  status          BlastStatus @default(PENDING_PAYMENT)
  blastMonth      String      // e.g. "2026-04"
  rejectionReason String?
  deliveredAt     DateTime?
  createdAt       DateTime    @default(now())

  sender   User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("message_blasts")
}

model Course {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  description   String
  thumbnail     String?
  level         CourseLevel  @default(BEGINNER)
  status        CourseStatus @default(DRAFT)
  price         Float        @default(0)
  isFree        Boolean      @default(true)
  isSequential  Boolean      @default(true)
  category      String
  tags          String[]
  learningOutcomes String[]
  requirements     String[]
  totalDuration Int          @default(0)
  instructorId  String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  instructor    User          @relation("InstructorCourses", fields: [instructorId], references: [id])
  sections    CourseSection[]
  enrollments Enrollment[]
  ratings       CourseRating[]

  @@map("courses")
}

model CourseSection {
  id        String   @id @default(cuid())
  title     String
  order     Int
  courseId  String
  createdAt DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("course_sections")
}

model Lesson {
  id          String            @id @default(cuid())
  title       String
  description String?
  contentType LessonContentType @default(VIDEO)
  videoUrl    String?
  textContent String?
  duration    Int               @default(0)
  order       Int
  isFree      Boolean           @default(false)
  sectionId   String
  createdAt   DateTime          @default(now())

  section  CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  quiz     Quiz?

  @@map("lessons")
}

model Quiz {
  id        String   @id @default(cuid())
  lessonId  String   @unique
  title     String
  passMark  Int      @default(70)
  createdAt DateTime @default(now())

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  question      String
  options       String[]
  correctAnswer Int
  explanation   String?
  order         Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  passed      Boolean
  answers     Int[]
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

model CourseRating {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  review    String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_ratings")
}

model AffiliateProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  code           String   @unique
  isActive       Boolean  @default(true)
  totalEarned    Float    @default(0)
  totalPaid      Float    @default(0)
  pendingBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals AffiliateReferral[]
  payouts   AffiliatePayout[]

  @@map("affiliate_profiles")
}

model AffiliateReferral {
  id             String           @id @default(cuid())
  affiliateId    String
  referredUserId String
  tier           SubscriptionTier
  commission     Float
  createdAt      DateTime         @default(now())

  affiliate    AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser User             @relation("ReferredUser", fields: [referredUserId], references: [id])

  @@map("affiliate_referrals")
}

model AffiliatePayout {
  id          String       @id @default(cuid())
  affiliateId String
  amount      Float
  method      String       @default("paypal")
  details     String
  status      PayoutStatus @default(PENDING)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("affiliate_payouts")
}

model AffiliateSettings {
  id                    String   @id @default(cuid())
  commissionVip         Float    @default(10)
  commissionMarketplace Float    @default(15)
  commissionPlus        Float    @default(20)
  minPayoutAmount       Float    @default(50)
  cookieDays            Int      @default(30)
  programEnabled        Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@map("affiliate_settings")
}

model AtlasSettings {
  id              String   @id @default(cuid())
  widgetEnabled   Boolean  @default(true)
  defaultProvider String   @default("openai")
  allowedTiers    String[] @default(["FREE","VIP","MARKETPLACE","MARKETPLACE_PLUS"])
  maxTokens       Int      @default(1024)
  systemPromptExtra String @default("")
  updatedAt       DateTime @updatedAt

  @@map("atlas_settings")
}

model Space {
  id          String    @id @default(cuid())
  name        String
  description String?
  hostId      String
  roomName    String    @unique
  isLive      Boolean   @default(true)
  scheduledAt DateTime?           // null = started immediately; future = scheduled
  shareToken  String?   @unique   // short token for shareable invite link
  createdAt   DateTime  @default(now())
  endedAt     DateTime?

  host  User        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  rsvps SpaceRsvp[]

  @@map("spaces")
}

model SpaceRsvp {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String?
  name      String
  email     String?
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@map("space_rsvps")
}

model ProfessionalApplication {
  id          String    @id @default(cuid())
  userId      String    @unique
  status      AppStatus @default(PENDING)
  reason      String
  specialty   String
  credentials String
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("professional_applications")
}

model ProService {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  price       String?
  emoji       String   @default("⭐")
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pro_services")
}

model ProReview {
  id         String   @id @default(cuid())
  proId      String
  reviewerId String
  rating     Int      @default(5)
  content    String
  createdAt  DateTime @default(now())

  pro      User @relation("ReviewedPro", fields: [proId],      references: [id], onDelete: Cascade)
  reviewer User @relation("Reviewer",    fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([proId, reviewerId])
  @@map("pro_reviews")
}

model ToolkitPurchase {
  id                String   @id @default(cuid())
  userId            String
  toolkitId         String
  stripeSessionId   String   @unique
  membershipGranted Boolean  @default(false)
  membershipTier    String   @default("MARKETPLACE")
  membershipMonths  Int      @default(2)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("toolkit_purchases")
}

model ProAd {
  id              String       @id @default(cuid())
  userId          String
  title           String
  description     String?
  imageUrl        String
  linkUrl         String
  placement       AdPlacement
  durationMonths  Int
  priceUsd        Float
  stripeSessionId String?
  status          AdStatus     @default(PENDING_PAYMENT)
  rejectionReason String?
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pro_ads")
}

model Forum {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  image       String?
  isAdminOnly Boolean     @default(false)
  isPinned    Boolean     @default(false)
  badge       String?
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  posts       ForumPost[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("forums")
}

model ForumPost {
  id        String         @id @default(cuid())
  title     String
  body      String         @db.Text
  forumId   String
  forum     Forum          @relation(fields: [forumId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  votes     Int            @default(0)
  isPinned  Boolean        @default(false)
  comments  ForumComment[]
  userVotes ForumVote[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("forum_posts")
}

model ForumComment {
  id        String         @id @default(cuid())
  body      String         @db.Text
  postId    String
  post      ForumPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    ForumComment?  @relation("Replies", fields: [parentId], references: [id])
  replies   ForumComment[] @relation("Replies")
  votes     Int            @default(0)
  createdAt DateTime       @default(now())

  @@map("forum_comments")
}

model ForumVote {
  id     String    @id @default(cuid())
  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id])
  value  Int

  @@unique([postId, userId])
  @@map("forum_votes")
}

model ToolkitAsset {
  id         String   @id @default(cuid())
  toolkitId  String   @unique   // matches id in lib/toolkits.ts
  fileUrl    String             // Cloudinary secure URL
  fileName   String             // original file name for display
  fileSize   Int?               // bytes
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("toolkit_assets")
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  email       String
  subject     String
  description String
  status      String   @default("OPEN")
  feedback    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("support_tickets")
}

// ── NFC Business Card / Tap Card / Connect Card ─────────────────────────
// One DigitalCard per User (internal FK = userId). `username` is the mutable,
// public-facing slug used in /connect/[username] and /pro/[username] — never
// used for DB relationships.
model DigitalCard {
  id        String  @id @default(cuid())
  userId    String  @unique
  username  String  @unique

  isActivated Boolean   @default(false)
  activatedAt DateTime?

  // Card-specific business info (distinct from the member's main profile fields)
  professionalTitle   String?
  businessName        String?
  businessDescription String?
  phone               String?
  bookingUrl          String?
  businessAddress     String?
  logoUrl             String?

  // Design
  theme       String @default("classic")
  accentColor String @default("#0a1628")

  // Privacy controls (per-field visibility)
  phoneVisibility     CardVisibility @default(PUBLIC)
  emailVisibility     CardVisibility @default(PUBLIC)
  addressVisibility   CardVisibility @default(PRIVATE)
  bookingVisibility   CardVisibility @default(PUBLIC)
  websiteVisibility   CardVisibility @default(PUBLIC)
  socialVisibility    CardVisibility @default(PUBLIC)
  servicesVisibility  CardVisibility @default(PUBLIC)

  // Analytics counters
  pageViews         Int @default(0)
  nfcTaps           Int @default(0)
  qrScans           Int @default(0)
  contactSaves      Int @default(0)
  shareClicks       Int @default(0)
  fullProfileClicks Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  links CardLink[]

  @@map("digital_cards")
}

model CardLink {
  id     String @id @default(cuid())
  cardId String

  label String
  url   String
  icon  String?
  color String?

  order      Int     @default(0)
  isActive   Boolean @default(true)
  clickCount Int     @default(0)

  scheduledStart DateTime?
  scheduledEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card DigitalCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("card_links")
}

// ── ERO Training Center (staff due-diligence training) ──────────────────
// One TrainingVersion per filing-season edition of a toolkit's training
// (e.g. "2027 Filing Season Due-Diligence Staff Training" for toolkitId
// "irs-fine-defense"). Historical versions are preserved — never overwritten
// — so completed-training records always show which edition a preparer took.
model TrainingVersion {
  id        String  @id @default(cuid())
  toolkitId String
  versionLabel String

  isActive Boolean @default(true)

  videoProvider        String @default("youtube")
  videoId              String?
  videoUrl             String?
  videoDurationSeconds Int    @default(0)

  passingScore    Int @default(80)
  questionsToShow Int @default(25)
  maxAttempts     Int @default(2)

  acknowledgmentText String @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions   TrainingQuestion[]
  invitations StaffInvitation[]

  @@map("training_versions")
}

model TrainingQuestion {
  id           String  @id @default(cuid())
  versionId    String
  question     String  @db.Text
  options      String[]
  correctIndex Int
  explanation  String? @db.Text
  order        Int     @default(0)

  createdAt DateTime @default(now())

  version TrainingVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("training_questions")
}

// The ERO's seat license for a toolkit's staff training (auto-created with
// 5 seats when the toolkit is purchased; additional seats can be bought).
model TrainingLicense {
  id         String  @id @default(cuid())
  eroId      String
  toolkitId  String
  officeName String?
  totalSeats Int     @default(5)

  purchasedAt DateTime @default(now())
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ero           User                   @relation(fields: [eroId], references: [id], onDelete: Cascade)
  invitations   StaffInvitation[]
  seatPurchases TrainingSeatPurchase[]

  @@unique([eroId, toolkitId])
  @@map("training_licenses")
}

model TrainingSeatPurchase {
  id              String   @id @default(cuid())
  licenseId       String
  seats           Int
  priceUsd        Float
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())

  license TrainingLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("training_seat_purchases")
}

// One seat assignment = one invited preparer. Each preparer gets their own
// individual account (userId links once they accept + register) — never a
// shared office login.
model StaffInvitation {
  id        String @id @default(cuid())
  licenseId String
  eroId     String
  versionId String
  userId    String?

  name        String
  email       String
  inviteToken String         @unique
  status      TrainingStatus @default(INVITED)

  videoFurthestSeconds Int       @default(0)
  videoCompletedAt     DateTime?
  trainingStartedAt    DateTime?
  registeredAt         DateTime?
  revokedAt            DateTime?

  invitedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license        TrainingLicense         @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  ero            User                    @relation("EroInvitations", fields: [eroId], references: [id], onDelete: Cascade)
  version        TrainingVersion         @relation(fields: [versionId], references: [id])
  user           User?                   @relation("PreparerInvitations", fields: [userId], references: [id], onDelete: SetNull)
  attempts       AssessmentAttempt[]
  acknowledgment TrainingAcknowledgment?
  certificate    TrainingCertificate?

  @@unique([licenseId, email])
  @@map("staff_invitations")
}

model AssessmentAttempt {
  id            String    @id @default(cuid())
  invitationId  String
  attemptNumber Int
  questionIds   String[]
  answers       Int[]
  score         Int
  passed        Boolean
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?

  invitation StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("assessment_attempts")
}

model TrainingAcknowledgment {
  id            String   @id @default(cuid())
  invitationId  String   @unique
  fullName      String
  email         String
  officeName    String?
  versionLabel  String
  statements    String[]
  signatureName String
  ipAddress     String?
  userAgent     String?
  signedAt      DateTime @default(now())

  invitation StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("training_acknowledgments")
}

model TrainingCertificate {
  id                String   @id @default(cuid())
  invitationId      String   @unique
  certificateNumber String   @unique
  pdfUrl            String?
  score             Int
  versionLabel      String
  issuedAt          DateTime @default(now())

  invitation StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("training_certificates")
}

